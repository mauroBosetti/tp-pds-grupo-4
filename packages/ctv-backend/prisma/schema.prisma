generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agencia {
  id            String  @id @default(uuid()) @db.Uuid
  nombre        String
  codigoDeGrupo String? @map("codigo_de_grupo")
  // TODO: el MER pide codigo_de_grupo NOT NULL (char(6)); se difiere a otro slice.

  @@map("agencia")
}

model Cuenta {
  id        String @id @default(uuid()) @db.Uuid
  email     String @unique
  hashClave String @map("hash_clave")

  usuarioAdministrador UsuarioAdministrador?

  @@map("cuenta")
}

model UsuarioAdministrador {
  id       String @id @default(uuid()) @db.Uuid
  nombre   String
  cuentaId String @unique @map("cuenta_id") @db.Uuid
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])

  @@map("usuario_administrador")
}
