datasource db {
  provider = "postgresql"
  // sin "url" acá: ahora vive en prisma.config.ts
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Genera un diagrama entidad-relación (ERD) cada vez que se corre `prisma generate`
generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.svg"
  theme    = "forest"
}

model Agencia {
  id            String @id @default(uuid()) @db.Uuid
  nombre        String
  codigoDeGrupo String @unique @map("codigo_de_grupo") @db.Char(8)

  usuarios UsuarioAgencia[]
  paquetes Paquete[]

  @@map("agencia")
}

model Paquete {
  id            String  @id @default(uuid()) @db.Uuid
  nombre        String
  precio        Int
  origen        String
  destino       String
  vueloIdaId    Int     @map("vuelo_ida_id")
  vueloVueltaId Int     @map("vuelo_vuelta_id")
  agenciaId     String  @map("agencia_id") @db.Uuid
  agencia       Agencia @relation(fields: [agenciaId], references: [id])

  compras   Compra[]
  opiniones Opinion[]

  @@map("paquete")
}

model Cuenta {
  id        String @id @default(uuid()) @db.Uuid
  email     String @unique
  hashClave String @map("hash_clave")

  usuarioAdministrador UsuarioAdministrador?
  usuarioAgencia       UsuarioAgencia?
  usuarioCliente       UsuarioCliente?

  @@map("cuenta")
}

model UsuarioAdministrador {
  id       String @id @default(uuid()) @db.Uuid
  nombre   String
  cuentaId String @unique @map("cuenta_id") @db.Uuid
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])

  @@map("usuario_administrador")
}

model UsuarioAgencia {
  id        String  @id @default(uuid()) @db.Uuid
  nombre    String
  cuentaId  String  @unique @map("cuenta_id") @db.Uuid
  cuenta    Cuenta  @relation(fields: [cuentaId], references: [id])
  agenciaId String  @map("agencia_id") @db.Uuid
  agencia   Agencia @relation(fields: [agenciaId], references: [id])

  @@map("usuario_agencia")
}

model UsuarioCliente {
  id       String @id @default(uuid()) @db.Uuid
  nombre   String
  cuentaId String @unique @map("cuenta_id") @db.Uuid
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])

  compras   Compra[]
  opiniones Opinion[]

  @@map("usuario_cliente")
}

model Compra {
  id               String         @id @default(uuid()) @db.Uuid
  fecha            DateTime       @default(now())
  usuarioClienteId String         @map("usuario_cliente_id") @db.Uuid
  usuarioCliente   UsuarioCliente @relation(fields: [usuarioClienteId], references: [id])
  paqueteId        String         @map("paquete_id") @db.Uuid
  paquete          Paquete        @relation(fields: [paqueteId], references: [id])

  @@map("compra")
}

model Opinion {
  usuarioClienteId String         @map("usuario_cliente_id") @db.Uuid
  usuarioCliente   UsuarioCliente @relation(fields: [usuarioClienteId], references: [id])
  paqueteId        String         @map("paquete_id") @db.Uuid
  paquete          Paquete        @relation(fields: [paqueteId], references: [id])
  favorito         Boolean        @default(false)
  comentario       String?
  puntaje          Int?

  @@id([usuarioClienteId, paqueteId])
  @@map("opinion")
}
