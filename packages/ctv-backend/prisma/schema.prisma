datasource db {
  provider = "postgresql"
  // sin "url" acá: ahora vive en prisma.config.ts
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Genera un diagrama entidad-relación (ERD) cada vez que se corre `prisma generate`
generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.svg"
  theme    = "forest"
}

model Agencia {
  id            String  @id @default(uuid()) @db.Uuid
  nombre        String
  codigoDeGrupo String? @map("codigo_de_grupo")
  // TODO: el MER pide codigo_de_grupo NOT NULL (char(6)); se difiere a otro slice.

  @@map("agencia")
}

model Cuenta {
  id        String @id @default(uuid()) @db.Uuid
  email     String @unique
  hashClave String @map("hash_clave")

  usuarioAdministrador UsuarioAdministrador?

  @@map("cuenta")
}

model UsuarioAdministrador {
  id       String @id @default(uuid()) @db.Uuid
  nombre   String
  cuentaId String @unique @map("cuenta_id") @db.Uuid
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])

  @@map("usuario_administrador")
}
