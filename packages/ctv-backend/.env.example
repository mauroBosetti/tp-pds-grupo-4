# Debe coincidir con las credenciales del servicio "ctv-postgres" del docker-compose.yml de la raíz
DATABASE_URL="postgresql://ctv:ctv@localhost:5432/ctv?schema=public"

# PORT=3000
# DATABASE_URL="postgresql://ctv:ctv@localhost:5432/ctv"

JWT_SECRET="cambiar-en-produccion"

# URL del servicio api-vuelos. Con docker compose es http://api-vuelos:4000; si corrés api-vuelos
# local con `npm run dev` (sin PORT) escucha en el 4001.
API_VUELOS_URL="http://localhost:4001"

ADMIN1_NOMBRE="Admin Uno"
ADMIN1_EMAIL="admin1@ctv.com"
ADMIN1_PASSWORD="admin1234"

ADMIN2_NOMBRE="Admin Dos"
ADMIN2_EMAIL="admin2@ctv.com"
ADMIN2_PASSWORD="admin1234"

ADMIN3_NOMBRE="Admin Tres"
